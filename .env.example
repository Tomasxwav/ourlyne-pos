# ── Base de datos ───────────────────────────────────────────────
# Postgres. En local, `pnpm dev` levanta automáticamente un Postgres embebido
# (binarios oficiales, sin Docker) en el puerto 5433 con datos en ./.pgdata.
# En producción usa la URL de tu proveedor (Neon, Supabase, RDS…).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ourlyne_pos
# Sin DATABASE_URL se usa PGlite (Postgres en WASM) en ./.pglite — solo pruebas rápidas.
# PGLITE_DIR=./.pglite

# ── Autenticación (Better Auth) ─────────────────────────────────
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth opcional
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Stripe ──────────────────────────────────────────────────────
# Sin estas variables la facturación funciona en "modo demo".
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Seed (solo desarrollo) ──────────────────────────────────────
# Usuarios demo: demo@ourlyne.com (propietario), cajero@ourlyne.com (cajero),
# admin@ourlyne.com (superadmin de la plataforma). Contraseña:
SEED_PASSWORD="Ourlyne#2026"
